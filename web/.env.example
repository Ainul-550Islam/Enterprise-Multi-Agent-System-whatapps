# Server-side MAS API base URL. The browser never sees this — the BFF proxies.
MAS_API_URL=http://localhost:8080

# OIDC (authorization-code + PKCE). Leave blank to hide the OIDC button.
OIDC_ISSUER=http://localhost:8081/realms/mas
OIDC_CLIENT_ID=mas-web
OIDC_CLIENT_SECRET=replace-with-idp-client-secret

# AES-256-GCM key material for the httpOnly session cookie. ≥32 characters.
# Example value only — operators inject a real secret at deploy time.
SESSION_SECRET=replace-with-32-plus-character-session-secret

# Optional public origin used to build the OIDC redirect URI.
MAS_WEB_ORIGIN=http://localhost:3000

# Next.js telemetry opt-out for air-gapped deployments.
NEXT_TELEMETRY_DISABLED=1
