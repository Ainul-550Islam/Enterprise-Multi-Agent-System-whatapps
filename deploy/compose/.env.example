# .env.example — every variable the services actually read.
# Copy to .env and fill in operator-supplied values. These are DEV-ONLY
# placeholders; production values must come from secret references / external
# secrets, never from this file. Never commit real secrets.

# ── Database (mas owns `mas` role; `mas_app` is the app least-privilege role) ──
MAS_DB_PASSWORD=mas_dev_pw
MAS_TEST_DATABASE_URL=postgres://mas:mas@127.0.0.1:55432/mas_live
MAS_TEST_DATABASE_APP_URL=postgres://mas_app:mas_app_pw@127.0.0.1:55432/mas_live

# ── mas-api ──
MAS_ENV=development
MAS_API_HTTP_ADDR=0.0.0.0:8080
MAS_API_GRPC_ADDR=0.0.0.0:50051
MAS_DATABASE_URL=postgres://mas:${MAS_DB_PASSWORD}@postgres:5432/mas_live

# ── Rust -> Python AI bridge ──
MAS_AI_BRIDGE_ENDPOINT=http://orchestrator:9100
MAS_AI_BRIDGE_TOKEN=dev-bridge-token
MAS_AI_BRIDGE_INTERNAL_SIGNING_SECRET=dev-internal-signing-secret
# TLS (optional, dev only):
# MAS_AI_BRIDGE_TLS_CA_CERTIFICATE_PATH=
# MAS_AI_BRIDGE_TLS_CLIENT_CERTIFICATE_PATH=
# MAS_AI_BRIDGE_TLS_CLIENT_PRIVATE_KEY_PATH=
MAS_AI_BRIDGE_TIMEOUT_MS=120000
MAS_AI_BRIDGE_MAX_RESPONSE_BYTES=8388608

# ── Worker ──
MAS_WORKER_NAME=worker-1
MAS_WORKER_CONSUMER=tasks-main
MAS_WORKER_FILTER=mas.tasks.>
MAS_WORKER_BATCH_SIZE=10
MAS_WORKER_ACK_WAIT_MS=30000
MAS_WORKER_POLL_MS=250
MAS_WORKER_LEASE_TTL_MS=30000
MAS_WORKER_MAX_IN_FLIGHT=16
MAS_WORKER_DRAIN_TIMEOUT_MS=30000
MAS_WORKER_RETRY_BASE_MS=250
MAS_WORKER_RETRY_CAP_MS=10000
MAS_WORKER_RETRY_MAX_DELIVER=8

# ── Scheduler ──
MAS_SCHEDULER_COMPLETION_ADDR=127.0.0.1:8090
MAS_SCHEDULER_REPLICA_ID=scheduler-1
MAS_SCHEDULER_INTERVAL_MS=1000
MAS_SCHEDULER_RECOVER_ON_START=true
MAS_SCHEDULER_ERROR_BACKOFF_CAP_MS=30000
MAS_SCHEDULER_API_URL=http://api:8080
MAS_SCHEDULER_API_BEARER=

# ── Orchestrator (Python) ──
MAS_ORCHESTRATOR_ENVIRONMENT=development
MAS_ORCHESTRATOR_BIND_HOST=127.0.0.1
MAS_ORCHESTRATOR_BIND_PORT=9100
MAS_ORCHESTRATOR_RUST_CORE_ENDPOINT=127.0.0.1:50051
MAS_ORCHESTRATOR_SERVICE_TOKEN_SECRET_REF=ref://orchestrator/service-token
MAS_ORCHESTRATOR_SECURITY_INTERNAL_SERVICE_SECRET_REF=ref://orchestrator/internal-signing-secret
MAS_ORCHESTRATOR_PROVIDERS_ENABLED_PROVIDERS=
MAS_ORCHESTRATOR_PROVIDERS_ALLOWED_MODELS=
MAS_ORCHESTRATOR_PROVIDERS_DEFAULT_MODEL=
MAS_ORCHESTRATOR_OBSERVABILITY_LOG_LEVEL=info
MAS_ORCHESTRATOR_OBSERVABILITY_LOG_FORMAT=json

# ── NATS ──
MAS_NATS_URL=nats://nats:4222
MAS_BROKER_KIND=nats

# ── Vault / secrets (presence only; values from secret manager) ──
# MAS_VAULT_URL=
# MAS_VAULT_TOKEN=
# MAS_VAULT_NAMESPACE=
