{
  "kind": "AgentDefinition",
  "apiVersion": "mas/v1",
  "metadata": {
    "name": "Demo Support Agent",
    "slug": "demo-support-agent",
    "labels": { "demo": "true", "channel": "whatsapp" }
  },
  "spec": {
    "kind": "standard",
