# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Type checking / lint caches
.mypy_cache/
.ruff_cache/

# Generated protobuf artifacts (regenerate with scripts/generate_proto.sh)
src/mas_orchestrator/grpc/generated/*_pb2.py
src/mas_orchestrator/grpc/generated/*_pb2.pyi
src/mas_orchestrator/grpc/generated/*_pb2_grpc.py

# Secret-bearing local development files — NEVER commit real credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
.secrets/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
